{
  "expo": {
    "name": "Thenvue",
    "slug": "thenvue",
    "scheme": "thenvue",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/master/thenvue-logo-square-1024.png",
    "splash": {
      "image": "./assets/brand/master/thenvue-logo-master-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1E1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thenvue.app",
      "icon": "./assets/brand/master/thenvue-logo-square-1024.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Thenvue uses your camera to capture photos of moments you want to remember.",
        "NSMicrophoneUsageDescription": "Thenvue uses your microphone to record and transcribe voice memories.",
        "NSPhotoLibraryUsageDescription": "Thenvue accesses your photo library to attach photos to your memories.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thenvue.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_background.png",
        "backgroundColor": "#1C1E1D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Thenvue to access your camera to take memory photos."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Thenvue to access your microphone to record voice memories."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Thenvue to access your photos to attach them to your memories."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "4c313d53-8e7a-41eb-aa6c-e0a9df319f2e"
      }
    }
  }
}
